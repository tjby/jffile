{
  "paths": {
    "source": "/data/jellyfin/uploads",
    "movies": "/data/jellyfin/movies",
    "tvshows": "/data/jellyfin/tvshows",
    "reports": "./logs"
  },
  "behavior": {
    "mode": "move",
    "on_conflict": "skip",
    "prune_empty_dirs": false,
    "stable_seconds": 0,
    "keep_episode_title": true,
    "max_episodes_in_md": 5
  },
  "subtitle": {
    "enabled": true,
    "map_language": false
  },
  "manifest": {
    "enabled": true,
    "name": "jf-ingest",
    "format": "md",
    "merge": true,
    "include_skipped": true
  },
  "permissions": {
    "enabled": false,
    "owner": "jellyfin:jellyfin",
    "dir_mode": "0755",
    "file_mode": "0644"
  },
  "jellyfin": {
    "refresh": true,
    "refresh_mode": "paths",
    "url": "http://localhost:8096",
    "api_key": "",
    "timeout": 10
  }
}
